{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.mjs",
      "**/*.json",
      "!**/fixtures",
      "!!**/dist",
      "!node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
